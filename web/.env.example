# Los valores VITE_ son públicos y se usan únicamente para iniciar sesión.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Estos valores son exclusivos del servidor. Nunca use VITE_ para secretos.
DATABASE_URL=postgresql://usuario:clave@host:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

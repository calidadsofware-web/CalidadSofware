@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Registrar solicitud de cotizacion";
}

<partial name="_UseCaseHeader" model="Model" />

<form method="post" class="workspace-grid">
    @Html.AntiForgeryToken()
    <section class="panel main-panel">
        <div class="panel-title">
            <div>
                <h2>Datos de la solicitud</h2>
                <p>Registre productos y seleccione proveedores para enviar la solicitud.</p>
            </div>
            <span class="code-chip">SC-2026-0007</span>
        </div>

        <div class="form-grid">
            <div>
                <label class="form-label">Responsable</label>
                <input class="form-control" value="Asistente de Compras" />
            </div>
            <div>
                <label class="form-label">Fecha limite</label>
                <input class="form-control" type="date" value="2026-07-15" />
            </div>
            <div class="span-2">
                <label class="form-label">Observaciones</label>
                <textarea class="form-control" rows="3">Cotizacion para reposicion de accesorios con mayor rotacion.</textarea>
            </div>
        </div>

        <div class="panel-subtitle">
            <h3>Productos solicitados</h3>
            <div class="action-row">
                <button class="btn btn-outline-primary" type="button" data-action="quick-create" data-type="product">Crear producto</button>
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#productSearchModal">Buscar producto</button>
            </div>
        </div>

        <div class="table-responsive data-panel">
            <table class="table align-middle mb-0" data-operation-table="request">
                <thead>
                    <tr>
                        <th>N</th>
                        <th>Producto</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio ref.</th>
                        <th class="text-end">Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var product in Model.Products)
                    {
                        <tr data-product-code="@product.Code" data-product-name="@product.Name">
                            <td>@index</td>
                            <td>@product.Name</td>
                            <td class="text-end"><input class="form-control table-input" name="request_@product.Code" value="10" min="1" type="number" data-quantity /></td>
                            <td class="text-end">S/. @product.Price.ToString("0.00")</td>
                            <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" data-action="remove-row">Quitar</button></td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="panel side-panel">
        <div class="panel-subtitle tight">
            <h2>Proveedores seleccionados</h2>
            <div class="action-row">
                <button class="btn btn-outline-primary" type="button" data-action="quick-create" data-type="supplier">Crear proveedor</button>
                <a class="btn btn-outline-primary" asp-action="BuscarProveedor">Buscar</a>
            </div>
        </div>

        <div class="compact-list" data-supplier-list>
            @foreach (var supplier in Model.Suppliers.Take(2))
            {
                <div>
                    <span>@supplier.BusinessName</span>
                    <button class="btn btn-sm btn-link" type="button" data-action="remove-row">Quitar</button>
                </div>
            }
        </div>

        <div class="info-box">
            Agregue productos y seleccione proveedores para enviar la solicitud de cotizacion.
        </div>

        <div class="action-row stacked">
            <button class="btn btn-light" type="reset">Cancelar</button>
            <button class="btn btn-outline-primary" type="button" data-action="preview">Ver detalle</button>
            <button class="btn btn-success" type="submit">Enviar solicitud</button>
        </div>
    </aside>
</form>

<partial name="_ProductSearchModal" model="Model.Products" />

@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Generar CDP";
}

<partial name="_UseCaseHeader" model="Model" />

<form method="post" class="workspace-grid">
    @Html.AntiForgeryToken()
    <section class="panel main-panel">
        <div class="panel-title">
            <div>
                <h2>Datos del comprobante</h2>
                <p>Valide el cliente y el tipo de comprobante antes de generar el CDP.</p>
            </div>
            <span class="code-chip">B001-000125</span>
        </div>

        <div class="form-grid">
            <div>
                <label class="form-label">Tipo CDP</label>
                <select class="form-select" name="tipoCdp">
                    <option>Boleta</option>
                    <option>Factura</option>
                </select>
            </div>
            <div>
                <label class="form-label">Cliente</label>
                <input class="form-control" name="cliente" value="Maria Torres" />
            </div>
            <div>
                <label class="form-label">Documento</label>
                <input class="form-control" name="documento" value="45678912" />
            </div>
            <div>
                <label class="form-label">Metodo de pago</label>
                <select class="form-select" name="metodoPago">
                    <option>Yape</option>
                    <option>Efectivo</option>
                    <option>Tarjeta</option>
                    <option>Transferencia</option>
                </select>
            </div>
        </div>

        <div class="panel-subtitle">
            <h3>Productos vendidos</h3>
            <div class="action-row">
                <button class="btn btn-outline-primary" type="button" data-action="quick-create" data-type="client">Crear cliente</button>
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#productSearchModal">Agregar producto</button>
            </div>
        </div>

        <div class="table-responsive data-panel">
            <table class="table align-middle mb-0" data-operation-table="cdp">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Producto</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products.Take(3))
                    {
                        <tr data-product-code="@product.Code" data-product-name="@product.Name" data-price="@product.Price">
                            <td class="fw-semibold">@product.Code</td>
                            <td>@product.Name</td>
                            <td class="text-end"><input class="form-control table-input" name="qty_@product.Code" value="1" min="1" type="number" data-quantity /></td>
                            <td class="text-end">S/. @product.Price.ToString("0.00")</td>
                            <td class="text-end" data-line-total>S/. @product.Price.ToString("0.00")</td>
                            <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" data-action="remove-row">Quitar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="panel side-panel">
        <h2>Resumen de venta</h2>
        <div class="totals-list">
            @{
                var subtotal = Model.Products.Take(3).Sum(product => product.Price);
                var igv = subtotal * 0.18m;
                var total = subtotal + igv;
            }
            <span>Subtotal <strong data-subtotal>S/. @subtotal.ToString("0.00")</strong></span>
            <span>IGV 18% <strong data-igv>S/. @igv.ToString("0.00")</strong></span>
            <span class="total">Total <strong data-total>S/. @total.ToString("0.00")</strong></span>
        </div>
        <div class="info-box">
            El CDP queda asociado a ventas, cliente, detalle de productos y reporte de pagos.
        </div>
        <div class="action-row stacked">
            <button class="btn btn-light" type="reset">Cancelar</button>
            <button class="btn btn-outline-primary" type="button" data-action="preview">Vista previa</button>
            <button class="btn btn-primary" type="submit">Generar CDP</button>
        </div>
    </aside>
</form>

<partial name="_ProductSearchModal" model="Model.Products" />

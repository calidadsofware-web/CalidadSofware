@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Buscar proveedor";
}

<partial name="_UseCaseHeader" model="Model" />

<section class="panel">
    <form method="get" class="filter-panel" data-filter-scope data-target="[data-search-table='suppliers']">
        <div>
            <label class="form-label">RUC</label>
            <input class="form-control" placeholder="20123456789" data-filter-field />
        </div>
        <div>
            <label class="form-label">Razon social</label>
            <input class="form-control" placeholder="Buscar proveedor" data-filter-field />
        </div>
        <div>
            <label class="form-label">Estado</label>
            <select class="form-select" data-filter-field>
                <option>Todos</option>
                <option>Activo</option>
                <option>Inactivo</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit" data-action="filter">Buscar</button>
            <button class="btn btn-outline-primary" type="button" data-action="clear-filter">Limpiar</button>
        </div>
    </form>
</section>

<section class="panel mt-3">
    <div class="panel-title">
        <div>
            <h2>Proveedores registrados</h2>
            <p>Directorio para cotizaciones, compras y recepcion.</p>
        </div>
        <button class="btn btn-primary" type="button" data-action="quick-create" data-type="supplier">Crear proveedor</button>
    </div>
    <div class="table-responsive data-panel">
        <table class="table align-middle mb-0" data-search-table="suppliers" data-export-table>
            <thead>
                <tr>
                    <th>RUC</th>
                    <th>Proveedor</th>
                    <th>Contacto</th>
                    <th>Telefono</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th class="text-end">Accion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model.Suppliers)
                {
                    <tr>
                        <td class="fw-semibold">@supplier.Ruc</td>
                        <td>@supplier.BusinessName</td>
                        <td>@supplier.Contact</td>
                        <td>@supplier.Phone</td>
                        <td>@supplier.Email</td>
                        <td>@supplier.Status</td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-primary" type="button" data-action="show-row-detail">Seleccionar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Registrar ingreso de productos";
}

<partial name="_UseCaseHeader" model="Model" />

<form method="post" class="workspace-grid">
    @Html.AntiForgeryToken()
    <section class="panel main-panel">
        <div class="panel-title">
            <div>
                <h2>Datos de recepcion</h2>
                <p>Confirme la compra y los productos recibidos antes de afectar inventario.</p>
            </div>
            <span class="code-chip">REC-2026-0012</span>
        </div>

        <div class="form-grid">
            <div>
                <label class="form-label">Orden de compra</label>
                <select class="form-select" name="ordenCompra">
                    <option>OC-2026-0006 - CompuSolutions S.A.C.</option>
                    <option>OC-2026-0005 - Importaciones Movil E.I.R.L.</option>
                </select>
            </div>
            <div>
                <label class="form-label">Proveedor</label>
                <input class="form-control" name="proveedor" value="CompuSolutions S.A.C." />
            </div>
            <div>
                <label class="form-label">Guia / Documento</label>
                <input class="form-control" name="guia" placeholder="Ej. T001-000876" />
            </div>
            <div>
                <label class="form-label">Fecha de ingreso</label>
                <input class="form-control" name="fecha" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="panel-subtitle">
            <h3>Detalle recibido</h3>
            <div class="action-row">
                <button class="btn btn-outline-primary" type="button" data-action="quick-create" data-type="product">Crear producto</button>
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#productSearchModal">Agregar producto</button>
            </div>
        </div>

        <div class="table-responsive data-panel">
            <table class="table align-middle mb-0" data-operation-table="entry">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Solicitado</th>
                        <th class="text-end">Recibido</th>
                        <th>Estado</th>
                        <th class="text-end">Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products.Where(p => p.Stock <= p.MinStock + 10).Take(3))
                    {
                        <tr data-product-code="@product.Code" data-product-name="@product.Name">
                            <td>@product.Name</td>
                            <td class="text-end">20</td>
                            <td class="text-end"><input class="form-control table-input" name="received_@product.Code" value="20" min="1" type="number" data-quantity /></td>
                            <td><span class="status-pill status-ok">Completo</span></td>
                            <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" data-action="remove-row">Quitar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="panel side-panel">
        <h2>Impacto en inventario</h2>
        <div class="info-box">
            Al guardar, el sistema debe crear recepcion, detalle de recepcion y movimiento de inventario tipo COMPRA.
        </div>
        <label class="form-label">Observaciones</label>
        <textarea class="form-control" name="observaciones" rows="5" placeholder="Condicion de entrega, faltantes o diferencias"></textarea>
        <div class="action-row stacked">
            <button class="btn btn-light" type="reset">Cancelar</button>
            <button class="btn btn-primary" type="submit">Registrar ingreso</button>
        </div>
    </aside>
</form>

<partial name="_ProductSearchModal" model="Model.Products" />

@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Buscar producto";
}

<partial name="_UseCaseHeader" model="Model" />

<section class="panel">
    <form method="get" class="filter-panel" data-filter-scope data-target="[data-search-table='products']">
        <div>
            <label class="form-label">Codigo</label>
            <input class="form-control" placeholder="PROD-001" data-filter-field />
        </div>
        <div>
            <label class="form-label">Nombre o descripcion</label>
            <input class="form-control" placeholder="Buscar producto" data-filter-field />
        </div>
        <div>
            <label class="form-label">Categoria</label>
            <select class="form-select" data-filter-field>
                <option>Todas</option>
                <option>Protectores</option>
                <option>Cargadores</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit" data-action="filter">Buscar</button>
            <button class="btn btn-outline-primary" type="button" data-action="clear-filter">Limpiar</button>
        </div>
    </form>
</section>

<section class="panel mt-3">
    <div class="panel-title">
        <div>
            <h2>Productos disponibles</h2>
            <p>Resultado compatible con ventas, cotizaciones, compras e inventario.</p>
        </div>
        <button class="btn btn-primary" type="button" data-action="quick-create" data-type="product">Crear producto</button>
    </div>
    <div class="table-responsive data-panel">
        <table class="table align-middle mb-0" data-search-table="products" data-export-table>
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Producto</th>
                    <th>Categoria</th>
                    <th>Marca</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Accion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td class="fw-semibold">@product.Code</td>
                        <td>@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.Brand</td>
                        <td class="text-end">@product.Stock</td>
                        <td class="text-end">S/. @product.Price.ToString("0.00")</td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-primary" type="button" data-action="show-row-detail">Ver detalle</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

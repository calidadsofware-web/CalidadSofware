@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Generar reporte de pago";
}

<partial name="_UseCaseHeader" model="Model" />

<section class="panel">
    <div class="panel-title">
        <div>
            <h2>Filtros del reporte</h2>
            <p>Seleccione periodo, metodo y estado de pago para generar el reporte.</p>
        </div>
        <button class="btn btn-primary" type="button" data-action="filter">Generar reporte</button>
    </div>

    <form method="get" class="filter-panel" data-filter-scope data-target="[data-search-table='payments']">
        <div>
            <label class="form-label">Desde</label>
            <input class="form-control" type="date" value="2026-07-01" />
        </div>
        <div>
            <label class="form-label">Hasta</label>
            <input class="form-control" type="date" value="2026-07-10" />
        </div>
        <div>
            <label class="form-label">Metodo</label>
            <select class="form-select" data-filter-field>
                <option>Todos</option>
                <option>Efectivo</option>
                <option>Yape</option>
                <option>Tarjeta</option>
            </select>
        </div>
        <div>
            <label class="form-label">Estado</label>
            <select class="form-select" data-filter-field>
                <option>Todos</option>
                <option>Pagado</option>
                <option>Observado</option>
            </select>
        </div>
    </form>
</section>

<div class="workspace-grid mt-3">
    <section class="panel main-panel">
        <div class="table-responsive data-panel">
            <table class="table align-middle mb-0" data-search-table="payments" data-export-table>
                <thead>
                    <tr>
                        <th>CDP</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Metodo</th>
                        <th>Estado</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td class="fw-semibold">@payment.Document</td>
                            <td>@payment.Client</td>
                            <td>@payment.Date</td>
                            <td>@payment.Method</td>
                            <td>@payment.Status</td>
                            <td class="text-end">S/. @payment.Total.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="panel side-panel">
        <h2>Resumen</h2>
        <div class="totals-list">
            @{
                var totalPaid = Model.Payments.Where(payment => payment.Status == "Pagado").Sum(payment => payment.Total);
                var observed = Model.Payments.Count(payment => payment.Status == "Observado");
            }
            <span>Total cobrado <strong>S/. @totalPaid.ToString("0.00")</strong></span>
            <span>Operaciones <strong>@Model.Payments.Count</strong></span>
            <span>Observados <strong>@observed</strong></span>
        </div>
        <div class="action-row stacked">
            <button class="btn btn-outline-primary" type="button" data-action="export" data-format="pdf">Exportar PDF</button>
            <button class="btn btn-outline-primary" type="button" data-action="export" data-format="excel">Exportar Excel</button>
        </div>
    </aside>
</div>

@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Registrar solicitud de compra";
}

<partial name="_UseCaseHeader" model="Model" />

<form method="post" class="workspace-grid">
    @Html.AntiForgeryToken()
    <section class="panel main-panel">
        <div class="panel-title">
            <div>
                <h2>Datos de la solicitud</h2>
                <p>Priorice productos con stock bajo y registre la necesidad de compra.</p>
            </div>
            <span class="code-chip">SC-2026-0008</span>
        </div>

        <div class="form-grid">
            <div>
                <label class="form-label">Proveedor sugerido</label>
                <select class="form-select" name="proveedor">
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <option>@supplier.BusinessName</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Prioridad</label>
                <select class="form-select">
                    <option>Alta</option>
                    <option>Media</option>
                    <option>Baja</option>
                </select>
            </div>
            <div>
                <label class="form-label">Solicitante</label>
                <input class="form-control" value="Asistente de Compras" />
            </div>
            <div>
                <label class="form-label">Fecha requerida</label>
                <input class="form-control" type="date" value="2026-07-12" />
            </div>
        </div>

        <div class="panel-subtitle">
            <h3>Productos solicitados</h3>
            <div class="action-row">
                <button class="btn btn-outline-primary" type="button" data-action="quick-create" data-type="supplier">Crear proveedor</button>
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#productSearchModal">Buscar producto</button>
            </div>
        </div>

        <div class="table-responsive data-panel">
            <table class="table align-middle mb-0" data-operation-table="request">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Minimo</th>
                        <th class="text-end">Cantidad sugerida</th>
                        <th class="text-end">Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products.OrderBy(p => p.Stock).Take(4))
                    {
                        <tr data-product-code="@product.Code" data-product-name="@product.Name">
                            <td>@product.Name</td>
                            <td class="text-end">@product.Stock</td>
                            <td class="text-end">@product.MinStock</td>
                            <td class="text-end"><input class="form-control table-input" name="request_@product.Code" value="20" min="1" type="number" data-quantity /></td>
                            <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" data-action="remove-row">Quitar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="panel side-panel">
        <h2>Validacion</h2>
        <div class="info-box">
            La solicitud pasa a estado PENDIENTE y luego puede aprobarse para generar una compra.
        </div>
        <label class="form-label">Justificacion</label>
        <textarea class="form-control" rows="5">Reposicion por productos en nivel minimo de stock.</textarea>
        <div class="action-row stacked">
            <button class="btn btn-light" type="reset">Cancelar</button>
            <button class="btn btn-primary" type="submit">Guardar solicitud</button>
        </div>
    </aside>
</form>

<partial name="_ProductSearchModal" model="Model.Products" />

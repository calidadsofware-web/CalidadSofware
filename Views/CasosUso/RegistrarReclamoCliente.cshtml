@model Pagina_Web.Models.ViewModels.UseCasePageViewModel

@{
    ViewData["Title"] = "Registrar reclamo de cliente";
}

<partial name="_UseCaseHeader" model="Model" />

<form method="post" class="workspace-grid">
    @Html.AntiForgeryToken()
    <section class="panel main-panel">
        <div class="panel-title">
            <div>
                <h2>Datos del reclamo</h2>
                <p>Asocie el reclamo a un cliente y comprobante para trazabilidad postventa.</p>
            </div>
            <span class="code-chip">REC-CLI-0003</span>
        </div>

        <div class="form-grid">
            <div>
                <label class="form-label">Cliente</label>
                <input class="form-control" value="Camila Rojas" />
            </div>
            <div>
                <label class="form-label">CDP relacionado</label>
                <select class="form-select">
                    <option>B001-000122</option>
                    <option>B001-000118</option>
                </select>
            </div>
            <div>
                <label class="form-label">Tipo de reclamo</label>
                <select class="form-select">
                    <option>Producto defectuoso</option>
                    <option>Cambio solicitado</option>
                    <option>Atencion recibida</option>
                </select>
            </div>
            <div>
                <label class="form-label">Canal</label>
                <select class="form-select">
                    <option>Presencial</option>
                    <option>WhatsApp</option>
                    <option>Correo</option>
                </select>
            </div>
        </div>

        <label class="form-label mt-3">Descripcion del reclamo</label>
        <textarea class="form-control" rows="5">Cliente indica que el cargador no realiza carga rapida.</textarea>

        <div class="panel-subtitle">
            <h3>Clientes recientes</h3>
            <div class="action-row">
                <button class="btn btn-outline-primary" type="button" data-action="quick-create" data-type="client">Crear cliente</button>
                <a class="btn btn-outline-primary" asp-action="BuscarCliente">Buscar cliente</a>
            </div>
        </div>

        <div class="table-responsive data-panel">
        <table class="table align-middle mb-0" data-search-table="claim-clients">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Cliente</th>
                        <th>Ultimo CDP</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients.Take(3))
                    {
                        <tr>
                            <td>@client.Document</td>
                            <td>@client.FullName</td>
                            <td>@client.LastPurchase</td>
                            <td>@client.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="panel side-panel">
        <h2>Seguimiento</h2>
        <div class="timeline-list">
            <span><strong>Registro</strong> Pendiente</span>
            <span><strong>Revision</strong> Almacen valida producto</span>
            <span><strong>Cierre</strong> Cambio, devolucion o rechazo</span>
        </div>
        <label class="form-label">Prioridad</label>
        <select class="form-select">
            <option>Media</option>
            <option>Alta</option>
            <option>Baja</option>
        </select>
        <div class="action-row stacked">
            <button class="btn btn-light" type="reset">Cancelar</button>
            <button class="btn btn-primary" type="submit">Registrar reclamo</button>
        </div>
    </aside>
</form>

@model Pagina_Web.Models.ViewModels.DatabaseConnectionStatusViewModel

@{
    ViewData["Title"] = "Base de datos";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">DataCell en Supabase</p>
        <h1>Estado de conexion PostgreSQL</h1>
    </div>
    <span class="status-pill @(Model.CanConnect ? "status-ok" : "status-error")">
        @(Model.CanConnect ? "Conectado" : "Pendiente")
    </span>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card">
            <span>Servidor</span>
            <strong>@(Model.Server ?? "Sin configurar")</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <span>Puerto</span>
            <strong>@(Model.Port ?? "5432")</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <span>Base</span>
            <strong>@(Model.DatabaseName ?? "postgres")</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <span>Version</span>
            <strong>@(Model.ServerVersion ?? "No disponible")</strong>
        </div>
    </div>
</div>

@if (!Model.CanConnect)
{
    <div class="alert alert-warning" role="alert">
        <strong>No se pudo validar la conexion.</strong>
        <div>@Model.ErrorMessage</div>
    </div>
}
else
{
    <div class="alert alert-success" role="alert">
        Conexion correcta con @Model.ProviderName. Revision: @Model.CheckedAt.ToString("dd/MM/yyyy HH:mm:ss")
    </div>

    <div class="table-responsive data-panel">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Tabla</th>
                    <th class="text-end">Registros</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TableCounts)
                {
                    <tr>
                        <td>@item.TableName</td>
                        <td class="text-end fw-semibold">@item.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

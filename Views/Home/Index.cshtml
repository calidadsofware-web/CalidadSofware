@model Pagina_Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel operativo";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Operacion comercial</p>
        <h1>Panel operativo DataCell</h1>
        <p class="lead text-muted mb-0">Seguimiento diario de ventas, inventario, compras y atencion al cliente para sostener una operacion rapida, trazable y con menos quiebres de stock.</p>
    </div>
    <span class="section-pill">Jornada actual</span>
</section>

<div class="metric-strip">
    @foreach (var metric in Model.Metrics)
    {
        <div class="metric-card">
            <span>@metric.Label</span>
            <strong>@metric.Value</strong>
            <small>@metric.Hint</small>
        </div>
    }
</div>

<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-title">
            <div>
                <h2>Productos en riesgo de quiebre</h2>
                <p>Prioridad para reposicion y solicitudes de compra.</p>
            </div>
            <a class="btn btn-outline-primary" asp-controller="CasosUso" asp-action="BuscarProducto">Ver catalogo</a>
        </div>
        <div class="table-responsive data-panel">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoria</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Minimo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LowStockProducts.Any())
                    {
                        <tr>
                            <td colspan="4">No hay productos debajo del stock minimo.</td>
                        </tr>
                    }
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td>@product.Category</td>
                            <td class="text-end">@product.Stock</td>
                            <td class="text-end">@product.MinStock</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-title">
            <div>
                <h2>Solicitudes de compra</h2>
                <p>Estado de reposicion y aprobaciones.</p>
            </div>
            <a class="btn btn-outline-primary" asp-controller="CasosUso" asp-action="BuscarSolicitudCompra">Seguimiento</a>
        </div>
        <div class="compact-list">
            @foreach (var request in Model.PurchaseRequests.Take(4))
            {
                <div>
                    <span>
                        <strong>@request.Number</strong>
                        @request.Supplier
                    </span>
                    <span class="status-pill @(request.Status == "Pendiente" ? "status-warn" : "status-ok")">@request.Status</span>
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-title">
            <div>
                <h2>Pagos recientes</h2>
                <p>Base para cierre de caja y conciliacion.</p>
            </div>
            <a class="btn btn-outline-primary" asp-controller="CasosUso" asp-action="GenerarReportePago">Reporte</a>
        </div>
        <div class="table-responsive data-panel">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>CDP</th>
                        <th>Cliente</th>
                        <th>Metodo</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments.Take(4))
                    {
                        <tr>
                            <td class="fw-semibold">@payment.Document</td>
                            <td>@payment.Client</td>
                            <td>@payment.Method</td>
                            <td class="text-end">S/. @payment.Total.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

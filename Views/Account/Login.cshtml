@model Pagina_Web.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso - DataCell</title>
    <link rel="icon" type="image/png" href="~/img/datacell-mark-v2.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-card" aria-labelledby="login-title">
            <div class="login-card-heading">
                <span class="login-kicker">Intranet DataCell</span>
                <h1 id="login-title">Iniciar sesión</h1>
                <p>Ingresa con las credenciales asignadas a tu rol.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post" class="login-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Correo</label>
                    <input class="form-control" asp-for="Email" autocomplete="username" inputmode="email" placeholder="nombre@datacell.local" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Contraseña</label>
                    <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" placeholder="Ingresa tu contraseña" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Ingresar al sistema</button>
            </form>
        </section>
    </main>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
